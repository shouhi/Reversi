{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": false
  },
  "comment": "Only the Worker sources are listed; tsc follows imports to type-check the reachable (Worker-safe) shared modules, and never pulls in the browser/Node/Next files.",
  "include": ["src/**/*.ts"]
}

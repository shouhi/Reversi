# ---------------------------------------------------------------------------
# Upstash Redis (required in production)
#
# Option A — Upstash directly: create a free database at
#   https://console.upstash.com/ and copy the "REST API" credentials here.
# Option B — Vercel Marketplace ("Upstash for Redis"): the integration injects
#   KV_REST_API_URL / KV_REST_API_TOKEN automatically (see the second block).
#
# The app accepts EITHER naming pair. Keep these secret — never commit .env.local.
# ---------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Provided automatically by the Vercel "Upstash for Redis" Marketplace
# integration. If these are set, UPSTASH_REDIS_REST_* above are not needed.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# ---------------------------------------------------------------------------
# Test / local-only escape hatch (DO NOT set in production).
# When set to "1", the app uses an in-process in-memory store instead of
# Redis. This only works for a single server process (local dev / E2E tests)
# and is ignored whenever Upstash credentials are present.
# ---------------------------------------------------------------------------
# REVERSI_MEMORY_STORE=1

# ---------------------------------------------------------------------------
# Optional: absolute site origin used for OGP / canonical URLs (SEO).
# If unset, the app uses Vercel's auto-injected production URL, then localhost.
# You normally do NOT need to set this on Vercel.
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app
